{ "@context": {
  "inq": "https://ikigai-rs.dev/ns/inquiry#",
  "ik": "https://ikigai-rs.dev/ns#",
  "dcterms": "http://purl.org/dc/terms/",
  "prov": "http://www.w3.org/ns/prov#",
  "xsd": "http://www.w3.org/2001/XMLSchema#",
  "Inquiry": "inq:Inquiry",
  "SpamExample": "inq:SpamExample",
  "Intent": "inq:Intent",
  "inquiry": "inq:inquiry",
  "site": "inq:site",
  "text": "inq:text",
  "replyTo": "inq:replyTo",
  "sender": "inq:sender",
  "reason": "inq:reason",
  "received": { "@id": "inq:received", "@type": "xsd:dateTime" },
  "intent": "inq:intent",
  "verdict": "inq:verdict",
  "example": "inq:example",
  "score": { "@id": "inq:score", "@type": "xsd:double" },
  "unjudged": { "@id": "inq:unjudged", "@type": "xsd:boolean" },
  "embedding": "inq:embedding",
  "embeddingModel": "inq:embeddingModel",
  "embeddingDigest": "inq:embeddingDigest",
  "label": "inq:label",
  "attributedTo": { "@id": "prov:wasAttributedTo", "@type": "@id" },
  "created": { "@id": "dcterms:created", "@type": "xsd:dateTime" },
  "seq": { "@id": "ik:seq", "@type": "xsd:integer" }
} }
